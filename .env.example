POSTGRES_DB=chainsignal
POSTGRES_USER=chainsignal
POSTGRES_PASSWORD=chainsignal_local_dev
POSTGRES_PORT=5432

BACKEND_PORT=8080
FRONTEND_PORT=3000

# Host-run frontend proxy (Compose uses http://backend:8080)
BACKEND_URL=http://localhost:8080
FRONTEND_ORIGIN=http://localhost:3000

# Backend event and nearby query bounds
EVENT_DEFAULT_LIMIT=100
EVENT_MAX_LIMIT=500
EVENT_DEFAULT_RADIUS_KM=100
EVENT_MAX_RADIUS_KM=1000

# Python data pipeline
CHAIN_SIGNAL_ENVIRONMENT=local
CHAIN_SIGNAL_LOG_LEVEL=INFO
CHAIN_SIGNAL_HTTP_TIMEOUT_SECONDS=10
CHAIN_SIGNAL_BRONZE_PATH=data/bronze
CHAIN_SIGNAL_NORMALIZED_PATH=data/normalized

# Python database persistence
CHAIN_SIGNAL_DB_HOST=localhost
CHAIN_SIGNAL_DB_PORT=5432
CHAIN_SIGNAL_DB_NAME=chainsignal
CHAIN_SIGNAL_DB_USER=chainsignal
CHAIN_SIGNAL_DB_PASSWORD=chainsignal_local_dev
CHAIN_SIGNAL_DB_CONNECT_TIMEOUT_SECONDS=10
